# MySQL 持久化配置
# 数据库引擎；本机部署使用 mysql，离线验收显式使用隔离 sqlite
DB_ENGINE=mysql
# MySQL 服务地址；本机部署使用 127.0.0.1
MYSQL_HOST=127.0.0.1
# MySQL 服务端口；默认端口为 3306
MYSQL_PORT=3306
# MySQL 登录用户名
MYSQL_USER=root
# MySQL 登录密码；部署时替换为真实密码，禁止提交真实密钥
MYSQL_PASSWORD=change-me
# 业务数据库名称；不存在时应用会尝试自动创建
MYSQL_DATABASE=ai_report_platform
# 数据库连接字符集；utf8mb4 可完整支持中文和扩展字符
MYSQL_CHARSET=utf8mb4
# MySQL 连接超时时间，单位为秒
MYSQL_CONNECT_TIMEOUT_SECONDS=10
# 兼容旧配置；本版本仅做增量迁移，不重建业务数据库
MYSQL_RESET_ON_STARTUP=false

# MinIO / S3 兼容对象存储配置
# 对象存储实现；minio 表示连接 MinIO 服务，local 仅用于本地测试
STORAGE_BACKEND=minio
# MinIO 服务访问地址，包含协议、主机和端口
OSS_ENDPOINT=http://172.20.0.116:9000
# MinIO 访问密钥（Access Key）
OSS_ACCESS_KEY=minioadmin
# MinIO 私密密钥（Secret Key）；部署时替换为真实密钥
OSS_SECRET_KEY=change-me
# 存放平台文件的对象存储桶名称；不存在时应用会尝试创建
OSS_BUCKET=knowledge-media
# 预签名下载地址的有效时间，单位为秒
OSS_PRESIGN_EXPIRE_SECONDS=3600

# 脚本沙箱与视觉质量校验配置
# Mac 隔离后端；auto/sandbox-exec，缺失或自检失败直接报错，不回退普通子进程
SCRIPT_SANDBOX_BACKEND=auto
# 单次脚本执行的最长时间，单位为秒
SCRIPT_SANDBOX_TIMEOUT_SECONDS=30
# 单次脚本允许占用的最大 CPU 时间，单位为秒
SCRIPT_SANDBOX_CPU_SECONDS=15
# 单次脚本允许使用的最大内存，单位为 MB
SCRIPT_SANDBOX_MEMORY_MB=512
# 单次脚本允许生成的最大输出大小，单位为字节（10485760 = 10 MB）
SCRIPT_SANDBOX_MAX_OUTPUT_BYTES=10485760
# 每路 stdout/stderr 日志的最大保存字节；超限终止脚本
SCRIPT_SANDBOX_MAX_LOG_BYTES=1048576
# 是否强制使用 LibreOffice 和 pdftoppm 进行原生文档渲染校验
VISUAL_QA_REQUIRE_NATIVE_RENDERER=true
# 单次文档渲染校验的最长时间，单位为秒
VISUAL_QA_RENDER_TIMEOUT_SECONDS=60

# Word/PDF 原生渲染器路径。macOS 安装 LibreOffice 后通常为下列路径；按实际安装位置调整。
SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# Apple Silicon Homebrew 示例；也可填写 command -v pdftoppm 的输出。
PDFTOPPM_PATH=/opt/homebrew/bin/pdftoppm
# Word 中文文本使用的字体族名；必须能被 LibreOffice/fontconfig 匹配。
DOCUMENT_FONT_FAMILY=Hiragino Sans GB
# 可选：额外字体目录；目录内包含 .otf/.ttf/.ttc 即可。系统字体已可识别时可留空。
DOCUMENT_FONT_DIR=

# 模型服务敏感配置加密
# 用于加密保存模型 API Key 的 Fernet 主密钥；部署时必须替换为独立随机值
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key

# 模型服务并发生成任务数；根据服务器配置调整
GENERATE_CONCURRENCY=8
# 导出前逐模块 AI 复核的并发上限；模型网关不稳时调小（如 2-3）
REVIEW_CONCURRENCY=5

# 模型调用超时与重试
# 可选：可信私有/代理 CA 或经可信根验证的缺失中间 CA 链（PEM）；相对路径以项目根目录为基准。
# 默认使用系统证书库及 Mozilla CA，始终校验证书和域名；修改后重启后端。
# cdn.juapi.net 漏发 YE2 链时可使用：backend/certs/letsencrypt-ye2-chain.pem
LLM_CA_BUNDLE=
# 是否读取环境及 macOS 系统代理；false 仅使模型连接直连，仍验证 HTTPS 证书。
LLM_TRUST_ENV=true
# 单次模型请求的整体限时（秒）；本地/推理模型生成较慢时可适当调大
LLM_REQUEST_TIMEOUT=1800
# 等待模型首个响应数据的最长时间（秒）；覆盖大提示词在本地模型上的长 prefill
LLM_FIRST_CHUNK_TIMEOUT=600
# 流式响应相邻数据块允许的最大间隔（秒）；超过判定连接停滞并自动重试
LLM_STREAM_IDLE_TIMEOUT=120
# 模型请求停滞或服务端临时故障时的自动重试次数
LLM_MAX_RETRIES=2

# ReAct 轮次与防卡死保护
# 单任务最大思考-行动轮次；0 = 不限制（推荐），由时间预算与卡死检测终止
REACT_MAX_TURNS=0
# 单任务实际运行时间上限（秒），0 关闭；不限制轮次时用它兜底
REACT_MAX_SECONDS=3600
# 同一动作与同一失败观察连续重复达到该次数判定卡死
REACT_STUCK_REPEAT_LIMIT=3
# 连续 run_python 执行失败达到该次数判定任务不可完成
REACT_MAX_RUN_FAILURES=8
# run_python 连续失败达到该次数时提示模型先分析原因再换做法
REACT_FAILURE_NUDGE=2
# 重复动作/相同失败观察先提醒换做法的次数，用尽仍无变化才中止
REACT_STUCK_NUDGE_LIMIT=2
# 连续仅执行代码、未提交成果达到该轮数时，在观察中注入 finish 提醒（0 关闭）
REACT_STALE_FINISH_NUDGE=6

# 导出前审核与自动修复（与生成一致，默认不设轮次上限）
# 逐模块/整稿修复轮次上限；0 = 不限制，由时间预算与无进展检测终止
REVIEW_MAX_ROUNDS=0
# 导出前审核+修复总时长预算（秒），0 关闭
REVIEW_MAX_SECONDS=5400
# 同一批 error 连续多轮没有变化时停止，避免无效消耗
REVIEW_NO_PROGRESS_LIMIT=3
# 单模块复核 ReAct 异常后的重试次数
REVIEW_MODULE_ATTEMPTS=3

# ReAct 上下文保护：估算接近模型窗口时自动压缩历史后继续
# 模型上下文窗口（token）；按所用模型调整（如 64K 模型填 64000；
# vLLM 等服务可用 GET /v1/models 返回的 max_model_len 查询）
REACT_CONTEXT_WINDOW_TOKENS=128000
# 估算值超过窗口的该比例即触发压缩
REACT_CONTEXT_COMPRESS_RATIO=0.75
# 压缩后保留的最近「助手回复+观察」组数
REACT_CONTEXT_KEEP_TURNS=4

# 模版 AI 分析：输出非法 JSON 时把错误回传给模型自修复（额外重试次数，0 关闭）
ANALYSIS_JSON_REPAIR_ATTEMPTS=2

# 客户端版本与更新检查（桌面端由 Electron 自动注入 APP_VERSION，浏览器部署可留空）
APP_VERSION=
UPDATE_REPO=lhc75/AI-report-generation
UPDATE_CHECK_TIMEOUT=12
UPDATE_CACHE_SECONDS=300
